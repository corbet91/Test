# --- Server ---
PORT=4000
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/revenue_dashboard?schema=public"

# --- Dashboard ---
# IANA time zone that decides what "today" is (default week + default day of /revenue/compare)
APP_TIMEZONE=UTC
# ISO 4217 code shown by the UI
CURRENCY=USD
